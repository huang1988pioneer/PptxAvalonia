<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:PptxAvalonia.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1200" d:DesignHeight="800"
        x:Class="PptxAvalonia.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Title="{Binding Title}"
        Width="1280" Height="820"
        MinWidth="900" MinHeight="600"
        DragDrop.AllowDrop="True">

  <Design.DataContext>
    <vm:MainViewModel />
  </Design.DataContext>

  <DockPanel>
    <!-- Toolbar -->
    <Border DockPanel.Dock="Top"
            Background="{DynamicResource SystemControlBackgroundChromeMediumBrush}"
            BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
            BorderThickness="0,0,0,1"
            Padding="10,8">
      <Grid ColumnDefinitions="Auto,*,Auto">
        <StackPanel Orientation="Horizontal" Spacing="8" Grid.Column="0">
          <Button Content="開啟 PPTX…"
                  Command="{Binding OpenFileCommand}"
                  Padding="14,6"
                  FontWeight="SemiBold" />
          <Separator Width="1" Margin="6,4" Background="{DynamicResource SystemControlForegroundBaseLowBrush}" />
          <Button Content="◀ 上一張"
                  Command="{Binding PreviousSlideCommand}"
                  Padding="10,6" />
          <TextBlock Text="{Binding PageLabel}"
                     VerticalAlignment="Center"
                     MinWidth="72"
                     TextAlignment="Center"
                     FontWeight="SemiBold" />
          <Button Content="下一張 ▶"
                  Command="{Binding NextSlideCommand}"
                  Padding="10,6" />
          <Separator Width="1" Margin="6,4" Background="{DynamicResource SystemControlForegroundBaseLowBrush}" />
          <Button Content="{Binding AutoPlayButtonText}"
                  Command="{Binding ToggleAutoPlayCommand}"
                  Padding="12,6"
                  FontWeight="SemiBold"
                  ToolTip.Tip="開始 / 停止自動放映（F5）" />
          <Button Content="從頭放映"
                  Command="{Binding StartAutoPlayFromBeginningCommand}"
                  Padding="10,6"
                  ToolTip.Tip="從第一張開始自動放映（Shift+F5）" />
          <TextBlock Text="間隔"
                     VerticalAlignment="Center"
                     Opacity="0.8"
                     Margin="4,0,0,0" />
          <ComboBox ItemsSource="{Binding IntervalOptions}"
                    SelectedItem="{Binding AutoPlayIntervalSeconds}"
                    Width="64"
                    MinHeight="32"
                    VerticalAlignment="Center"
                    ToolTip.Tip="每張投影片停留秒數" />
          <TextBlock Text="秒"
                     VerticalAlignment="Center"
                     Opacity="0.8" />
          <CheckBox Content="循環"
                    IsChecked="{Binding LoopAutoPlay}"
                    VerticalAlignment="Center"
                    ToolTip.Tip="播到最後一張後回到第一張" />
        </StackPanel>

        <TextBlock Grid.Column="1"
                   Text="{Binding FileName}"
                   VerticalAlignment="Center"
                   HorizontalAlignment="Center"
                   Opacity="0.85"
                   TextTrimming="CharacterEllipsis"
                   Margin="16,0" />

        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6">
          <Button Content="符合視窗"
                  Command="{Binding FitToWindowCommand}"
                  Padding="10,6"
                  ToolTip.Tip="完整顯示整張投影片（Ctrl+1）" />
          <Button Content="−" Command="{Binding ZoomOutCommand}" Width="36" Padding="0,6" ToolTip.Tip="縮小 (Ctrl+-)" />
          <Button Content="{Binding ZoomLabel}"
                  Command="{Binding ZoomResetCommand}"
                  MinWidth="96"
                  Padding="8,6"
                  ToolTip.Tip="還原 100% 原始大小 (Ctrl+0)" />
          <Button Content="＋" Command="{Binding ZoomInCommand}" Width="36" Padding="0,6" ToolTip.Tip="放大 (Ctrl++)" />
        </StackPanel>
      </Grid>
    </Border>

    <!-- Status bar -->
    <Border DockPanel.Dock="Bottom"
            Background="{DynamicResource SystemControlBackgroundChromeMediumBrush}"
            BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
            BorderThickness="0,1,0,0"
            Padding="12,6">
      <Grid ColumnDefinitions="*,Auto">
        <TextBlock Text="{Binding StatusText}"
                   VerticalAlignment="Center"
                   Opacity="0.9"
                   TextTrimming="CharacterEllipsis" />
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12">
          <Border IsVisible="{Binding IsAutoPlaying}"
                  Background="#1B5E20"
                  CornerRadius="4"
                  Padding="8,2">
            <TextBlock Text="{Binding AutoPlayStatus}"
                       Foreground="White"
                       FontSize="12"
                       VerticalAlignment="Center" />
          </Border>
          <TextBlock Text="{Binding ZoomLabel}" VerticalAlignment="Center" Opacity="0.75" />
          <TextBlock Text="{Binding PageLabel}" VerticalAlignment="Center" Opacity="0.7" />
          <TextBlock IsVisible="{Binding IsBusy}" Text="載入中…" VerticalAlignment="Center" FontWeight="SemiBold" />
        </StackPanel>
      </Grid>
    </Border>

    <!-- Body -->
    <Grid ColumnDefinitions="220,*">
      <!-- Thumbnail rail -->
      <Border Grid.Column="0"
              Background="{DynamicResource SystemControlBackgroundAltHighBrush}"
              BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
              BorderThickness="0,0,1,0">
        <DockPanel>
          <TextBlock DockPanel.Dock="Top"
                     Text="投影片"
                     FontWeight="SemiBold"
                     Margin="12,10,12,6"
                     Opacity="0.8" />
          <ListBox ItemsSource="{Binding Slides}"
                   SelectedItem="{Binding SelectedSlide}"
                   Background="Transparent"
                   Padding="8,0,8,8">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="vm:SlideItemViewModel">
                <Border Margin="0,0,0,10"
                        Padding="6"
                        CornerRadius="6"
                        Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}">
                  <DockPanel>
                    <TextBlock DockPanel.Dock="Bottom"
                               Text="{Binding DisplayNumber}"
                               HorizontalAlignment="Center"
                               Margin="0,6,0,0"
                               Opacity="0.75"
                               FontSize="12" />
                    <Border Background="White"
                            CornerRadius="3"
                            BoxShadow="0 1 4 #40000000"
                            ClipToBounds="True"
                            HorizontalAlignment="Center">
                      <ContentControl Content="{Binding Thumbnail}" />
                    </Border>
                  </DockPanel>
                </Border>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </DockPanel>
      </Border>

      <!-- Preview stage: single visual tree so the slide control has one parent -->
      <Border x:Name="PreviewHost"
              Grid.Column="1"
              Background="#2B2B2B">
        <Grid>
          <!-- Empty state -->
          <StackPanel IsVisible="{Binding !HasDocument}"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center"
                      Spacing="12">
            <TextBlock Text="PPTX 預覽"
                       FontSize="28"
                       FontWeight="Bold"
                       Foreground="White"
                       HorizontalAlignment="Center" />
            <TextBlock Text="開啟 .pptx，或把檔案拖放到此視窗"
                       FontSize="15"
                       Foreground="#CCCCCC"
                       HorizontalAlignment="Center" />
            <Button Content="選擇檔案…"
                    Command="{Binding OpenFileCommand}"
                    HorizontalAlignment="Center"
                    Margin="0,8,0,0"
                    Padding="20,10" />
          </StackPanel>

          <!--
            Fit mode: Viewbox Uniform fills the host → entire page visible.
            Manual mode: fixed display size inside ScrollViewer → scroll + exact zoom.
          -->
          <ScrollViewer x:Name="PreviewScroller"
                        IsVisible="{Binding HasDocument}"
                        Padding="24"
                        HorizontalScrollBarVisibility="Auto"
                        VerticalScrollBarVisibility="Auto">
            <Viewbox x:Name="SlideViewbox"
                     Stretch="Uniform"
                     StretchDirection="Both"
                     HorizontalAlignment="Center"
                     VerticalAlignment="Center">
              <Border Background="White"
                      BoxShadow="0 8 24 #66000000"
                      CornerRadius="2"
                      ClipToBounds="True"
                      Width="{Binding SlideNativeWidth}"
                      Height="{Binding SlideNativeHeight}">
                <ContentControl Content="{Binding CurrentSlideView}"
                                Width="{Binding SlideNativeWidth}"
                                Height="{Binding SlideNativeHeight}" />
              </Border>
            </Viewbox>
          </ScrollViewer>
        </Grid>
      </Border>
    </Grid>
  </DockPanel>
</Window>
